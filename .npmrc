# This repository is pnpm-ONLY.
# engine-strict makes the "engines" field in package.json enforced: the bogus
# npm/yarn engine values ("please-use-pnpm") cause npm/yarn to refuse to run,
# while pnpm satisfies "pnpm": ">=9". Package manager is pinned via
# package.json "packageManager": "pnpm@9.15.0" (used by Corepack).
engine-strict=true

# Supply-chain cooldown: refuse dependency versions published less than 7 days
# ago (10080 minutes) to dodge freshly-published malicious/hijacked releases.
# NOTE: pnpm honors this only on pnpm >= 10.16. The repo currently pins
# pnpm@9.15.0 (package.json packageManager), so this is INERT until the pin is
# bumped to a 10.16+ release. See openspec/backlog.md.
minimum-release-age=10080
