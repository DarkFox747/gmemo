// Esquema Prisma — LPMS Cloud (facade).
//
// NOTA IMPORTANTE: la columna generada `tsvector`, los índices GIN y `pgvector`
// NO se modelan acá (Prisma no los soporta nativamente). Se aplican por migración
// SQL cruda — ver DEVELOPMENT.md. La traducción completa del esquema v2
// (docs/artefactos/lpms_schema_v2.sql) es el próximo incremento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de sanidad del toolchain (se reemplaza por el esquema v2 completo).
model Project {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("project")
}
