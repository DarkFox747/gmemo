# Local development environment — copy to .env.dev and fill in your values.
# This file is safe to commit: it contains NO secrets, only placeholder values
# and documentation for the local dev harness (docker compose).

# Postgres connection string used by the app, migrate, and seed scripts.
# Matches the docker-compose.yml db service defaults (no TLS, local only).
DATABASE_URL=postgres://lpms:lpms@localhost:5432/lpms

# Set to "true" to activate the Gate-1 dev bypass (skips Cognito JWT validation).
# This flag is ONLY honoured when NODE_ENV=development; the guard in
# src/auth/authenticator.ts refuses it under any other value.
AUTH_DEV_BYPASS=true

# Must be "development" for seed.ts and AUTH_DEV_BYPASS to be active.
NODE_ENV=development

# HTTP port the app listens on.
PORT=3000

# ---------------------------------------------------------------------------
# MCP header required for tenant resolution
# ---------------------------------------------------------------------------
# Every POST /mcp request must carry this header. The value MUST match the
# remote_url column of the seeded repo row (see migrations/seed.dev.sql).
#
#   X-Git-Remote: https://github.com/crombie-dev/lpms-cloud.git
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Promotion pipeline -- dev stubs (safe to commit; bypasses are production-banned)
# ---------------------------------------------------------------------------

# Use the deterministic judge stub instead of the real Bedrock judge.
# FORBIDDEN when NODE_ENV=production (superRefine guard in src/config/index.ts).
JUDGE_STUB=true

# Verdict the stub judge returns for every item (accepted | rejected | uncertain).
JUDGE_STUB_VERDICT=accepted

# Skip GitHub OIDC JWT verification and return DEV_PROMOTE_PRINCIPAL instead.
# FORBIDDEN when NODE_ENV=production (superRefine guard in src/config/index.ts).
PROMOTE_OIDC_DEV_BYPASS=true
