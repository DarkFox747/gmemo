# Local development environment for running the server on the host (pnpm dev)
# against the docker compose database. Copy to .env and adjust if needed.
# Safe to commit: NO secrets, only local placeholder values.

# Postgres of the docker compose db service (published on host port 5433).
DATABASE_URL=postgres://gmemo:gmemo@localhost:5433/gmemo

# Development only. Every bypass/stub below is REFUSED when NODE_ENV=production
# (the config guard in src/config/index.ts fails at boot).
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug

AUTH_DEV_BYPASS=true          # Gate 1 (Cognito) stub; web users via X-Dev-User
JUDGE_STUB=true               # deterministic judge instead of Amazon Bedrock
EMBEDDER_STUB=true            # deterministic vectors instead of Titan v2
PROMOTE_OIDC_DEV_BYPASS=true  # /promote without a real GitHub OIDC token

# MCP requests must carry the seeded remote:
#   X-Git-Remote: https://github.com/crombie-llc/gmemo-demo.git
